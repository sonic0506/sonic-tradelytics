# src/config/env.ts의 스키마와 키가 같아야 해요(CI가 비교해요).
NODE_ENV=development
PORT=3000
TZ=UTC
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=3600
# 쉼표로 구분해요. 운영에서는 *를 쓸 수 없어요.
CORS_ORIGINS=http://localhost:5173
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# 토스 Open API (engine만 써요). 개발과 운영은 다른 키를 써요(R-014)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_WS_URL=wss://openapi-ws.tossinvest.com/ws/v1
TOSS_TOKEN_FILE=.toss-token.json
# 텔레그램 알림. BotFather에서 받은 토큰과 알림 받을 chat id. 비우면 알림을 보내지 않아요
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
