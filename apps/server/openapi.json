    "/v1/risk-events": {
      "get": {
        "operationId": "RiskEventController_findPage_v1",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "페이지(1부터)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "size",
            "required": false,
            "in": "query",
            "description": "페이지 크기(최대 100)",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "botIds",
            "required": false,
            "in": "query",
            "description": "봇 id (쉼표로 여러 개)",
            "schema": {
              "example": "1,2",
              "type": "string"
            }
          },
          {
            "name": "kinds",
            "required": false,
            "in": "query",
            "description": "이벤트 종류 (쉼표로 여러 개)",
            "schema": {
              "example": "daily_stop,feed_stale",
              "type": "string",
              "items": {
                "type": "string",
                "enum": [
                  "daily_stop",
                  "total_stop",
                  "streak_pause",
                  "rate_cap",
                  "kill_switch",
                  "batch_fail",
                  "feed_stale",
                  "record_fail",
                  "order_rejected",
                  "funds_waiting",
                  "bot_error"
                ]
              }
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "description": "시작 거래일 (YYYY-MM-DD, 포함)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "description": "끝 거래일 (YYYY-MM-DD, 포함)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RiskEventPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "VALIDATION_FAILED": {
                    "summary": "요청 값이 올바르지 않아요.",
                    "value": {
                      "type": "about:blank",
                      "title": "Bad Request",
                      "status": 400,
                      "detail": "요청 값이 올바르지 않아요.",
                      "code": "VALIDATION_FAILED",
                      "instance": "/v1/risk-events",
                      "requestId": "5f1c2a0e-8d6b-4c3e-9a7f-2b4d6e8f0a1c",
                      "errors": [
                        {
                          "field": "name",
                          "messages": [
                            "name should not be empty"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                },
                "examples": {
                  "HTTP_401": {
                    "summary": "Unauthorized",
                    "value": {
                      "type": "about:blank",
                      "title": "Unauthorized",
                      "status": 401,
                      "detail": "Unauthorized",
                      "code": "HTTP_401",
                      "instance": "/v1/risk-events",
                      "requestId": "5f1c2a0e-8d6b-4c3e-9a7f-2b4d6e8f0a1c"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "리스크·장애 이벤트와 알림 여부 (POL-RISK-12). 최신순",
        "tags": [
          "risk-events"
        ]
      }
    }
