{
  "name": "@sonic-tradelytics/server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write .",
    "start": "nest start --exec \"node --env-file-if-exists=.env\"",
    "start:dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:engine": "node --env-file-if-exists=.env dist/engine",
    "start:engine:dev": "nest start --watch --entryFile engine --exec \"node --env-file-if-exists=.env\"",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "nest build && vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit",
    "typeorm": "node --env-file-if-exists=.env \"$(node -p \"require.resolve('typeorm/cli.js')\")\" -d dist/infra/database/data-source.js",
    "migration:generate": "nest build && npm run typeorm -- migration:generate",
    "migration:run": "nest build && npm run typeorm -- migration:run",
    "migration:revert": "nest build && npm run typeorm -- migration:revert",
    "migration:check": "nest build && npm run typeorm -- migration:run && npm run typeorm -- migration:generate src/infra/database/migrations/pending --check",
    "openapi": "nest build && node scripts/openapi.mjs",
    "openapi:check": "nest build && node scripts/openapi.mjs --check",
    "lint:cycles": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-typeorm": "^2.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.23.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.10",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
